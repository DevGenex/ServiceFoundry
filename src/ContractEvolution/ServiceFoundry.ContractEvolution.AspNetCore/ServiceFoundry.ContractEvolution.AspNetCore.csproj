<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>0.1.0</Version>
    <PackageId>ServiceFoundry.ContractEvolution.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for ServiceFoundry.ContractEvolution — request version reading, automatic request-body upgrade middleware, and endpoint metadata helpers for versioned API surfaces.</Description>
    <PackageTags>contracts;versioning;aspnetcore;middleware;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="README.md" Condition="Exists('..\README.md')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServiceFoundry.ContractEvolution\ServiceFoundry.ContractEvolution.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
