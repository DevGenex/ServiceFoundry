<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>0.1.0</Version>
    <PackageId>ServiceFoundry.ConfigGuard</PackageId>
    <Description>Strict configuration contracts for .NET — required keys, unknown-key rejection, aliases with deprecation warnings, cross-field rules, named options support, and fail-fast startup validation. Integrates with IOptions&lt;T&gt; and works with any IConfiguration provider.</Description>
    <PackageTags>configuration;validation;options;dotnet;aspnetcore;iconfig</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="README.md" Condition="Exists('..\README.md')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ServiceFoundry.ConfigGuard.Hosting" />
  </ItemGroup>

</Project>
