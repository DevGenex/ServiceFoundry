<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>0.1.0</Version>
    <PackageId>ServiceFoundry.ReliableMessages.RabbitMQ</PackageId>
    <Description>RabbitMQ transport for ServiceFoundry.ReliableMessages — topic exchange publishing with persistent delivery, configurable routing key resolution, and automatic reconnection.</Description>
    <PackageTags>messaging;outbox;rabbitmq;amqp;transport;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServiceFoundry.ReliableMessages\ServiceFoundry.ReliableMessages.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="README.md" Condition="Exists('..\README.md')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ServiceFoundry.ReliableMessages.RabbitMQ.Tests" />
  </ItemGroup>

</Project>